#!/usr/bin/python3
import hashlib, json, os, pathlib, shutil, sys, urllib.request

if sys.argv[1:] != ["install-default"]:
    raise SystemExit("Usage: logos-model install-default (as root)")
if os.geteuid() != 0:
    raise SystemExit(
        "Model installation requires root; service user cannot modify models"
    )
lock = json.loads(pathlib.Path("/etc/logos/model.json").read_text())
target = pathlib.Path("/var/lib/logos/models/default.gguf")
part = target.with_suffix(".part")
target.parent.mkdir(parents=True, exist_ok=True)


def valid(path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1048576), b""):
            h.update(chunk)
    return h.hexdigest() == lock["checksum"].split(":")[1]


if target.exists():
    if not valid(target):
        raise SystemExit("Existing model checksum mismatch")
    print("Default model verified")
    raise SystemExit(0)
if shutil.disk_usage(target.parent).free < lock["bytes"] + 1024**3:
    raise SystemExit("Insufficient space; keep 1 GiB free after model download")
try:
    with urllib.request.urlopen(lock["url"], timeout=90) as src, part.open("wb") as dst:
        shutil.copyfileobj(src, dst, 1048576)
    if not valid(part):
        raise ValueError("Model checksum mismatch")
    os.chmod(part, 0o644)
    os.replace(part, target)
except BaseException:
    part.unlink(missing_ok=True)
    raise
print("Installed and verified " + lock["name"])
