#!/usr/bin/python3
import os
from logos_ai.config import read_config

c = read_config()
layers = c["GPU_LAYERS"]
if layers != "auto" and (not layers.isdigit() or int(layers) < 1):
    raise SystemExit("GPU offload is required")
if not os.path.isfile(c["MODEL"]):
    raise SystemExit("Model missing: run logos-model install-default")
os.execv(
    "/usr/bin/llama-server",
    [
        "llama-server",
        "--host",
        "127.0.0.1",
        "--port",
        c["LLAMA_PORT"],
        "--model",
        c["MODEL"],
        "--ctx-size",
        c["CONTEXT_SIZE"],
        "--n-gpu-layers",
        layers,
        "--parallel",
        "1",
        "--batch-size",
        "128",
        "--ubatch-size",
        "64",
        "--no-warmup",
    ],
)
